// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  number    String
  password  String
  actions   Action[]
  sales     Sale[]
  createdAt DateTime @default(now())

  @@map("users")
}

model Student {
  id            String                @id @default(uuid())
  name          String
  number        String
  grade         Int
  school        String
  type          String?
  gender        Gender
  organizations StudentOrganization[]
  createdAt     DateTime              @default(now())

  @@map("students")
}

model Organization {
  id            String                  @id @default(uuid())
  name          String
  subject       String
  picUrl        String
  // Controls listing order on the public landing page (and admin list) — lower shows first.
  displayOrder  Int                     @default(0)
  students      StudentOrganization[]
  inventory     OrganizationInventory[]
  bookInventory BookInventory[]
  saleItems     SaleItem[]
  createdAt     DateTime                @default(now())

  @@map("organizations")
}

// Join table: a student can belong to zero or more organizations, and an
// organization can have many students. Deleting an organization only removes
// the membership row, never the student.
model StudentOrganization {
  id        String       @id @default(uuid())
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  createdAt DateTime     @default(now())

  @@unique([studentId, orgId])
  @@map("student_organizations")
}

// One row per (org, grade) pair — codes aren't edition-specific, so a single count suffices.
model OrganizationInventory {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String
  grade      Int
  codesCount Int          @default(0)

  @@unique([orgId, grade])
  @@map("organization_inventory")
}

// A reusable, shared catalog of book editions (e.g. "Chapter 1", "Revision 2") — not org-specific.
model BookEdition {
  id        String          @id @default(uuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  inventory BookInventory[]
  saleItems SaleItem[]

  @@map("book_editions")
}

// One row per (org, grade, edition) triple — books are tracked per specific edition.
model BookInventory {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  grade     Int
  edition   BookEdition  @relation(fields: [editionId], references: [id])
  editionId String
  count     Int          @default(0)

  @@unique([orgId, grade, editionId])
  @@map("book_inventory")
}

model TimetableEntry {
  id            String   @id @default(uuid())
  classroom     String
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int
  grade         Int
  course        String
  teacherName   String
  teacherSchool String
  createdAt     DateTime @default(now())

  @@index([classroom, dayOfWeek])
  @@map("timetable_entries")
}

// Audit log: what was done, what changed, when, and by whom.
model Action {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  type      ActionType
  entity    String
  entityId  String?
  changes   Json?
  createdAt DateTime   @default(now())

  @@map("actions")
}

model Sale {
  id     String     @id @default(uuid())
  user   User       @relation(fields: [userId], references: [id])
  userId String
  items  SaleItem[]
  soldAt DateTime   @default(now())

  @@map("sales")
}

// A single line item within a sale — e.g. "2 books (Chapter 1) + 3 codes from org_2, grade 11".
model SaleItem {
  id         String        @id @default(uuid())
  sale       Sale          @relation(fields: [saleId], references: [id])
  saleId     String
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  orgId      String?
  grade      Int
  edition    BookEdition?  @relation(fields: [editionId], references: [id])
  editionId  String?
  booksCount Int           @default(0)
  codesCount Int           @default(0)

  @@map("sale_items")
}

model News {
  id          String   @id @default(uuid())
  title       String
  body        String?
  imageUrl    String?
  linkUrl     String?
  linkLabel   String?
  publishedAt DateTime @default(now())

  @@map("news")
}
