// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  number    String
  password  String
  actions   Action[]
  sales     Sale[]
  createdAt DateTime @default(now())

  @@map("users")
}

model Student {
  id        String       @id @default(uuid())
  name      String
  number    String
  grade     Int
  school    String
  type      String?
  gender    Gender
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  createdAt DateTime     @default(now())

  @@map("students")
}

model Organization {
  id        String                   @id @default(uuid())
  name      String
  subject   String
  picUrl    String
  students  Student[]
  inventory OrganizationInventory[]
  saleItems SaleItem[]
  createdAt DateTime                 @default(now())

  @@map("organizations")
}

// One row per (org, grade) pair — keeps book/code counts from mixing across grades.
model OrganizationInventory {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  grade      Int
  booksCount Int          @default(0)
  codesCount Int          @default(0)

  @@unique([orgId, grade])
  @@map("organization_inventory")
}

model TimetableEntry {
  id            String   @id @default(uuid())
  classroom     String
  dayOfWeek     Int
  sessionIndex  Int
  startTime     String?
  endTime       String?
  grade         Int
  course        String
  teacherName   String
  teacherSchool String
  createdAt     DateTime @default(now())

  @@map("timetable_entries")
}

// Audit log: what was done, what changed, when, and by whom.
model Action {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  type      ActionType
  entity    String
  entityId  String?
  changes   Json?
  createdAt DateTime   @default(now())

  @@map("actions")
}

model Sale {
  id     String     @id @default(uuid())
  user   User       @relation(fields: [userId], references: [id])
  userId String
  items  SaleItem[]
  soldAt DateTime   @default(now())

  @@map("sales")
}

// A single line item within a sale — e.g. "2 books + 3 codes from org_2, grade 11".
model SaleItem {
  id         String       @id @default(uuid())
  sale       Sale         @relation(fields: [saleId], references: [id])
  saleId     String
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  grade      Int
  booksCount Int          @default(0)
  codesCount Int          @default(0)

  @@map("sale_items")
}

model News {
  id          String   @id @default(uuid())
  title       String
  description String
  picUrl      String
  linkUrl     String?
  createdAt   DateTime @default(now())

  @@map("news")
}
