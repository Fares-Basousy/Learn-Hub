# Copy this file to .env (local dev) or configure these as environment
# variables in your hosting provider (e.g. Vercel Project Settings → Environment
# Variables) before deploying to production. All four are required.

# PostgreSQL connection string (Neon, Supabase, RDS, etc).
# Quirk of this repo: the Prisma CLI (prisma.config.ts / next.config.ts) reads
# the `postgresql` var below for migrations/build, while the app's runtime
# client (src/lib/prisma.ts) reads `DATABASE_URL`. Set BOTH to the exact same
# connection string, or migrations and the running app will read different
# databases.
postgresql="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — signs/encrypts session JWTs. Generate one with:
#   openssl rand -base64 64
NEXTAUTH_SECRET=""

# Vercel Blob — stores uploaded organization/news images.
# Create a Blob store in your Vercel project (Storage tab) and copy its
# read-write token, or run: vercel env pull  (after linking the project)
BLOB_READ_WRITE_TOKEN=""
